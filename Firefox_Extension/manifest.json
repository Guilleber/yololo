{
  "manifest_version": 3,
  "name": "yololo",
  "version": "2.0",
  "description": "Fact-check highlighted text using web search + LLM.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icon.png" }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://api.tavily.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": { "48": "icon.png" }
}
